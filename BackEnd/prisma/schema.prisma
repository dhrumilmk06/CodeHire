generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  clerkId      String    @unique
  email        String    @unique
  name         String?
  createdAt    DateTime  @default(now())
  profileImage String?
  role         String    @default("participant")
  updatedAt    DateTime  @updatedAt
  banned       Boolean   @default(false)
  sessions     Session[] @relation("HostSessions")
  participants Session[] @relation("ParticipantSessions")

  @@index([clerkId], map: "idx_user_clerkid")
}

model CustomProblem {
  id              String   @id
  title           String
  difficulty      String
  examples        Json
  starterCode     Json
  hiddenTestCases Json
  createdAt       DateTime @default(now())
  category        String?
  constraints     String[]
  expectedOutput  Json?
  ownerClerkId    String
  updatedAt       DateTime @updatedAt
  description     Json

  @@index([ownerClerkId])
  @@index([title])
}

model Session {
  id                   String                @id @default(cuid())
  hostId               String
  problemCodes         Json
  timings              Json
  notes                String?
  tags                 String[]
  decision             String?
  status               String                @default("active")
  createdAt            DateTime              @default(now())
  callId               String?
  difficulty           String
  participantClerkId   String?
  problem              String
  problems             Json
  rating               Int?                  @default(0)
  testCasesPassed      String?               @default("0/0")
  timeTaken            Int?                  @default(0)
  updatedAt            DateTime              @updatedAt
  hints                Json                  @default("[]")
  session_code         String?               @unique
  ai_review            Json?
  report_generated     Boolean               @default(false)
  report_url           String?
  language             String?               @default("javascript") @db.VarChar(50)
  agentActive          Boolean?              @default(false)
  lastCodeSnapshot     String?               @default("")
  stuckDetectedAt      DateTime?             @db.Timestamp(6)
  hintsGenerated       Int?                  @default(0)
  autoTestsRun         Int?                  @default(0)
  agentSummary         String?
  lastAgentCheckAt     DateTime?             @db.Timestamp(6)
  timeWarningAt        DateTime?             @db.Timestamp(6)
  sessionType          String                @default("coding")
  decisionStatus       String?
  decisionSentAt       DateTime?
  host                 User                  @relation("HostSessions", fields: [hostId], references: [clerkId])
  participant          User?                 @relation("ParticipantSessions", fields: [participantClerkId], references: [clerkId])
  snapshots            WhiteboardSnapshot[]
  bugBountySubmissions BugBountySubmission[]

  @@index([session_code], map: "idx_session_code")
  @@index([createdAt(sort: Desc)], map: "idx_session_createdat")
  @@index([hostId], map: "idx_session_hostid")
  @@index([status], map: "idx_session_status")
}

model WhiteboardSnapshot {
  id             String   @id @default(uuid())
  sessionId      String
  imageData      String
  excalidrawData String?
  label          String?
  aiScore        Int?
  aiFeedback     String?
  createdAt      DateTime @default(now())
  session        Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model BugBountyProblem {
  id                   Int                   @id @default(autoincrement())
  title                String
  language             String
  bountyPoints         Int                   @default(100)
  bugDescription       String
  bugHints             String?
  buggyCode            String
  createdAt            DateTime              @default(now())
  createdBy            String?
  difficultyLevel      String?
  estimatedTimeMinutes Int?
  hiddenTestCases      Json
  initialTestCases     Json
  updatedAt            DateTime              @updatedAt
  correctSolution      String?
  submissions          BugBountySubmission[]

  @@index([language])
  @@index([difficultyLevel])
  @@map("bug_bounty_problems")
}

model BugBountySubmission {
  id                   Int                 @id @default(autoincrement())
  status               String              @default("submitted")
  aiReviewFeedback     String?
  aiReviewScore        Int?
  autoTestResult       Json?
  createdAt            DateTime            @default(now())
  finalScore           Int?
  fixedCode            String
  manualReviewFeedback String?
  manualReviewScore    Int?
  problemId            Int
  sessionId            String?
  timeTakenSeconds     Int?
  updatedAt            DateTime            @updatedAt
  userId               String
  hintsUsed            BugBountyHintUsed[]
  problem              BugBountyProblem    @relation(fields: [problemId], references: [id], onDelete: Cascade)
  session              Session?            @relation(fields: [sessionId], references: [id])

  @@index([problemId])
  @@index([userId])
  @@index([sessionId])
  @@index([status])
  @@map("bug_bounty_submissions")
}

model BugBountyHintUsed {
  id           Int                 @id @default(autoincrement())
  requestedAt  DateTime            @default(now())
  submissionId Int
  submission   BugBountySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("bug_bounty_hints_used")
}
